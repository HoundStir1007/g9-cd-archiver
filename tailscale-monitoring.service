[Unit]
Description=Tailscale Connection Monitoring
Documentation=file:///opt/tailscale-monitoring/ubuntu_tailscale_monitoring.py
After=network.target tailscaled.service

[Service]
Type=oneshot
User=tailscale-monitor
Group=tailscale-monitor
ExecStart=/usr/bin/python3 /opt/tailscale-monitoring/ubuntu_tailscale_monitoring.py
EnvironmentFile=-/opt/tailscale-monitoring/.env
WorkingDirectory=/opt/tailscale-monitoring
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/tailscale-monitoring

[Install]
WantedBy=multi-user.target 