# Environment files (contain secrets)
.env
pihole/.env
*/.env

# Allow .env.template files (these are safe to commit)
!*.env.template
!*/.env.template

# Ubuntu installation files
ubuntu-24.04.2-desktop-amd64.iso

# Pi-hole runtime files (root-owned, don't track)
pihole/etc-pihole/logrotate
pihole/etc-pihole/*.db
pihole/etc-pihole/dhcp.leases

# Large video files (keep local only)
*.mp4

# Large log files
*.log
logs/
archive/logs/

# Media files
*.wav
*.mp3
*.avi
*.mkv
*.iso

# Analysis files (large JSON/data files)
*_analysis_*.json
*_analysis_*.txt
*_full_*.json

# Temporary and cache files
*.tmp
*.temp
.cache/
temp/

# System files
.DS_Store
Thumbs.db

# Archive large files
archive/completed_guides/music_curation/*/music_analysis_*.json
archive/completed_guides/music_curation/*/test_*/*.wav
digital_consolidation_analysis/*.txt
